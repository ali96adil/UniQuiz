# UniQuiz server
UNIQUIZ_HOST=0.0.0.0
UNIQUIZ_PORT=8787
# UNIQUIZ_DB_PATH=/absolute/path/to/uniquiz.db

# OSC show control (Ableton / Max for Live / QLab / other OSC listener)
# Disabled by default so show-control can never block local development.
UNIQUIZ_OSC_ENABLED=false
UNIQUIZ_OSC_HOST=127.0.0.1
UNIQUIZ_OSC_PORT=9001

# REQUIRED for the M7 admin/operator release. Create a unique secret (>=16 chars)
# for each real installation. Do not put your actual secret in Git or logs.
# UNIQUIZ_OPERATOR_PASSWORD=<set-in-private-local-environment>
