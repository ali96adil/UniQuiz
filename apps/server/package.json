{
  "name": "@uniquiz/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "start": "node dist/index.js",
    "ops:backup": "tsx src/backup-cli.ts backup",
    "ops:backups": "tsx src/backup-cli.ts list",
    "ops:restore": "tsx src/backup-cli.ts restore"
  },
  "dependencies": {
    "@uniquiz/shared": "workspace:*",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "socket.io": "4.8.4",
    "zod": "4.6.5",
    "@fastify/multipart": "10.1.2",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
